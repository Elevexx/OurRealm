          .then(
            (controller) => {

              // The user may have left while their GLB loaded.
              if (
                disposed
                ||
                realmLifeRemotes
                  .get(
                    remote.id
                  )
                !== remote
                ||
                remote
                  .avatarLoadingKey
                !== avatarKey
              ) {
                controller
                  ?.dispose?.();

                return;
