                remote.root.remove(
                  remote
                    .avatarController
                    .model
                );

                remote
                  .avatarController
                  .dispose?.();
              }

              remote
                .avatarController =
                  controller;

              remote.avatarKey =
                avatarKey;

              remote.avatarLoadingKey =
                null;

              remote.root.add(
                controller.model
              );

              // Hide the cyan emergency placeholder only after
              // the real GLB has successfully loaded.
              if (
                remote.placeholder
