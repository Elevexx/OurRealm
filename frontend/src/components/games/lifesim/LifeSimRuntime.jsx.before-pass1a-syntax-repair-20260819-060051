    let dy = (e.clientY - cy) / (rect.height / 2);

    const raw = Math.hypot(dx, dy);
    const mag = Math.min(1, raw);

    if (raw > 0) {
      dx = (dx / raw) * mag;
      dy = (dy / raw) * mag;
    }

    mobileMoveRef.current = { x: dx, y: dy, mag };

