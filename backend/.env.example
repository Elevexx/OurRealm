# OurRealm backend — environment variables
#
# Copy to backend/.env and adjust per environment. This file is for
# documentation only; secrets must never be committed.

# === Core ===
# MONGO_URL=mongodb://localhost:27017
# DB_NAME=ourrealm

# === Auth cookies (Phase production readiness) ===
# COOKIE_SECURE=true        # Use Secure cookie attribute (HTTPS required)
# COOKIE_SAMESITE=lax       # lax | strict | none

# === CORS ===
# CORS_ORIGINS=https://ourrealm.social,https://www.ourrealm.social
# CORS_ALLOW_WILDCARD=false # never set true in production

# === OTP echo (dev-only) ===
# OTP_DISPLAY_IN_RESPONSE=false  # set true in local dev for offline OTP testing

# === Admin role promotion (no UI) ===
# ADMIN_PROMOTE_USERNAMES=alice:moderator,bob:support_admin
# (founder role is reserved for @stealth and cannot be granted via env)

# === User-uploaded media storage (PART 4) ===
# UPLOADS_ROOT is the ONE knob production deployments need to set.
# It must point at a directory that is backed by a persistent volume
# mounted by Emergent Support so uploads survive every pod restart,
# rebuild, deploy, and migration. The backend creates `audio/`,
# `images/`, and `videos/` subdirectories under this root automatically.
#
# Recommended: have Emergent Support mount the persistent volume at
# /data/ourrealm and leave UPLOADS_ROOT unset (the backend will detect
# /data/ourrealm and use it as the default).
#
# UPLOADS_ROOT=/data/ourrealm
#
# Per-kind override (only if you need separate volumes per media kind):
# AUDIO_STORAGE_DIR=/mnt/audio
# IMAGE_STORAGE_DIR=/mnt/images
# VIDEO_STORAGE_DIR=/mnt/videos
#
# Future migration target — when R2 / S3 credentials are provisioned,
# only services/storage.py changes; URLs, media IDs, metadata,
# permissions, and playback all stay identical.
# STORAGE_BACKEND=local       # local | r2 | s3 (only `local` is implemented today)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_HOSTNAME=          # optional CDN/custom-domain prefix
